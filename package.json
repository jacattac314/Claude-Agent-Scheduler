{
  "name": "tpm-portfolio",
  "version": "1.0.0",
  "description": "TPM Portfolio Website with Testing",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:visual": "playwright test",
    "test:a11y": "jest tests/accessibility.test.js",
    "test:html": "jest tests/html-validation.test.js",
    "validate": "npm run test && npm run test:visual",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "vercel:dev": "vercel dev",
    "vercel:logs": "vercel logs",
    "vercel:inspect": "vercel inspect",
    "vercel:env": "vercel env ls",
    "predeploy": "npm run validate",
    "mcp:start": "node mcp-server/index.js",
    "debug:prod": "node scripts/debug-deployment.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@modelcontextprotocol/server-vercel": "^0.1.0",
    "@playwright/test": "^1.40.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.0",
    "html-validate": "^8.9.0",
    "jest": "^29.7.0",
    "lighthouse": "^11.4.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "vercel": "^33.0.0"
  },
  "keywords": [
    "portfolio",
    "tpm",
    "technical-program-manager"
  ],
  "author": "",
  "license": "MIT"
}
