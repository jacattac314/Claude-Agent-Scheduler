{
  "name": "claude-agent-scheduler",
  "version": "1.0.0",
  "description": "A local-first desktop application for scheduling AI agents with calendar interface",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:next dev:electron",
    "dev:next": "next dev renderer",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "build": "npm run build:next && npm run build:main",
    "build:next": "next build renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest"
  },
  "keywords": ["electron", "scheduler", "ai", "agents", "calendar"],
  "author": "Claude Agent Scheduler",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^18.19.3",
    "@types/react": "^18.2.45",
    "@types/react-big-calendar": "^1.8.9",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "autoprefixer": "^10.4.16",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "date-fns": "^3.0.6",
    "date-fns-tz": "^2.0.0",
    "electron-is-dev": "^2.0.0",
    "moment": "^2.29.4",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-big-calendar": "^1.9.2",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.claude.agent-scheduler",
    "productName": "Claude Agent Scheduler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
