{
  "name": "claude-agent-scheduler",
  "version": "1.0.0",
  "description": "A local-first desktop app to create, schedule, and manage AI agents",
  "main": "dist-electron/main.js",
  "author": "Claude Agent Scheduler",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev -p 3456",
    "dev:electron": "wait-on http://localhost:3456 && NODE_ENV=development electron .",
    "build": "npm run build:next && npm run build:electron",
    "build:next": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^2.0.0",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-big-calendar": "^1.8.7",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1",
    "next": "^14.1.0",
    "lucide-react": "^0.344.0",
    "framer-motion": "^11.0.8",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.57",
    "@types/react-big-calendar": "^1.8.9",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^29.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.claude.agent-scheduler",
    "productName": "Claude Agent Scheduler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "category": "Utility"
    }
  }
}
