{
  "mcpServers": {
    "vercel": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-vercel"],
      "env": {
        "VERCEL_API_TOKEN": "${VERCEL_API_TOKEN}"
      },
      "description": "Vercel MCP Server for deployment management and production debugging",
      "capabilities": {
        "deployments": {
          "list": true,
          "create": true,
          "inspect": true,
          "logs": true,
          "cancel": true
        },
        "projects": {
          "list": true,
          "get": true,
          "update": true
        },
        "environment": {
          "list": true,
          "add": true,
          "remove": true
        },
        "domains": {
          "list": true,
          "add": true,
          "verify": true
        },
        "debugging": {
          "logs": true,
          "metrics": true,
          "traces": true
        }
      },
      "tools": [
        {
          "name": "deploy",
          "description": "Deploy the current project to Vercel",
          "parameters": {
            "environment": {
              "type": "string",
              "enum": ["production", "preview"],
              "default": "preview"
            },
            "force": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "name": "get_deployment_logs",
          "description": "Retrieve logs from a specific deployment for debugging",
          "parameters": {
            "deploymentId": {
              "type": "string",
              "required": true
            },
            "follow": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "name": "list_deployments",
          "description": "List all deployments with their status",
          "parameters": {
            "limit": {
              "type": "number",
              "default": 10
            },
            "state": {
              "type": "string",
              "enum": ["BUILDING", "ERROR", "READY", "CANCELED"]
            }
          }
        },
        {
          "name": "inspect_deployment",
          "description": "Get detailed information about a deployment including why it failed",
          "parameters": {
            "deploymentId": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_env_vars",
          "description": "List environment variables for the project",
          "parameters": {
            "decrypt": {
              "type": "boolean",
              "default": false
            }
          }
        },
        {
          "name": "add_env_var",
          "description": "Add a new environment variable",
          "parameters": {
            "key": {
              "type": "string",
              "required": true
            },
            "value": {
              "type": "string",
              "required": true
            },
            "target": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["production", "preview", "development"]
              },
              "default": ["production", "preview", "development"]
            }
          }
        },
        {
          "name": "cancel_deployment",
          "description": "Cancel a running deployment",
          "parameters": {
            "deploymentId": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_project_info",
          "description": "Get project information and settings",
          "parameters": {
            "includeEnv": {
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    }
  },
  "aiIntegration": {
    "enabled": true,
    "features": {
      "deploymentAnalysis": {
        "enabled": true,
        "description": "AI-powered analysis of deployment failures and suggestions for fixes"
      },
      "logAnalysis": {
        "enabled": true,
        "description": "Intelligent log parsing and error pattern recognition"
      },
      "performanceInsights": {
        "enabled": true,
        "description": "AI-driven performance recommendations based on deployment metrics"
      },
      "documentationAssistance": {
        "enabled": true,
        "description": "Contextual documentation lookup and integration help"
      }
    }
  },
  "debugging": {
    "productionLogging": true,
    "sourceMapSupport": true,
    "errorReporting": true,
    "performanceMonitoring": true
  }
}
